{
  "name": "rag-study-companion",
  "version": "0.2.1",
  "private": true,
  "description": "RAG Study Companion - notebook-based document Q&A",
  "author": "Folio",
  "license": "MIT",
  "main": "electron/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "autoprefixer": "^10.6.1",
    "dompurify": "^3.4.16",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "marked": "^12.0.2",
    "postcss": "^8.5.29",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17"
  },
  "scripts": {
    "test:e2e": "playwright test",
    "build": "node frontend/build.mjs",
    "build:check": "node frontend/build.mjs --check",
    "electron:start": "electron .",
    "electron:dist": "electron-builder"
  },
  "build": {
    "appId": "com.folio.studycompanion",
    "productName": "Folio",
    "files": [
      "electron/**/*",
      "frontend/index.html",
      "frontend/dist/**/*",
      "frontend/vendor/**/*",
      "frontend/logo.png",
      "package.json",
      "!backend/**",
      "!backend/.env"
    ],
    "extraResources": [
      {
        "from": "build/rag-backend",
        "to": "backend"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "THIRD_PARTY_NOTICES.txt",
        "to": "THIRD_PARTY_NOTICES.txt"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
