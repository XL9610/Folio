# RAG Study Companion — Environment Configuration
# Copy this file to .env and fill in your values.
# ==============================================================================
#
# /api/search — local retrieval, works WITHOUT an LLM.
# /api/ask   — agentic QA, requires LLM_REMOTE_ENABLED=true AND LLM_API_KEY.
#              If disabled, /api/ask returns HTTP 503 with code llm_not_configured.
#              No fallback answers — either LLM works, or the call fails explicitly.
#
# ==============================================================================

# ──────────────────────────────────────────────────────────────────────────────
# PATHS — override only if you want non-default locations
# ──────────────────────────────────────────────────────────────────────────────
# LOCAL_DATA_DIR=../local-data   # defaults to <repo-root>/local-data
# DATABASE_URL=sqlite:///./local-data/rag_companion.db
# BM25X_INDEX_DIR=./local-data/bm25x_data

# Keyword search backend. Default is ImprovedFTS5 (pure-Python, deterministic).
# BM25x is opt-in and requires a separately installed `bm25x` wheel — its Rust
# source is not vendored and it is not in requirements.txt (see ADR 0001).
# BM25X_ENABLED=false

# ──────────────────────────────────────────────────────────────────────────────
# REQUIRED — Database & Search (needed for upload, search, and chunking)
# ──────────────────────────────────────────────────────────────────────────────

# SQLite database path (relative to backend/ or absolute)
DATABASE_URL=sqlite:///./local-data/rag_companion.db

# Dense vectors are stored in SQLite via sqlite-vec — no separate service needed.

# Local sentence-transformers model (downloaded on first use, ~130MB cache)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Device: "cpu", "cuda", or leave default cpu. CUDA falls back to CPU on failure.
EMBEDDING_DEVICE=cpu

# ──────────────────────────────────────────────────────────────────────────────
# OPTIONAL — Remote LLM for /api/ask (agentic chat Q&A)
# ──────────────────────────────────────────────────────────────────────────────
# /api/search works without an LLM.  /api/ask requires all three:
#   LLM_REMOTE_ENABLED=true
#   LLM_API_KEY=<your key>
#   LLM_BASE_URL=<provider endpoint>

LLM_REMOTE_ENABLED=false
LLM_API_KEY=

# Provider preset key (openai | anthropic | google | deepseek | local | custom)
# and API format (openai-compatible | anthropic | google). Both are optional and
# written by the Settings UI; they drive display + preset pre-fill only.
LLM_PROVIDER=
LLM_API_FORMAT=openai-compatible

# Example: DeepSeek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Optional: Max output tokens for LLM calls
LLM_MAX_TOKENS=4096

# Optional: Temperature for LLM calls (0.0-2.0)
LLM_TEMPERATURE=0.1

# ──────────────────────────────────────────────────────────────────────────────
# OPTIONAL — Reranker (improves /api/ask retrieval ranking, adds ~3-5s latency)
# ──────────────────────────────────────────────────────────────────────────────
# Adds an LLM relevance pass after hybrid retrieval. Improves ranking
# quality but requires LLM_REMOTE_ENABLED=true and adds ~$0.003 per query.
RERANK_ENABLED=false
RERANK_TOP_N=20
RERANK_CONCURRENCY=10
RERANK_MAX_DOC_CHARS=2000

# ──────────────────────────────────────────────────────────────────────────────
# OPTIONAL — Internet research (web search for /api/ask)
# ──────────────────────────────────────────────────────────────────────────────
# Written by the Settings UI. "tavily" enables web search; "disabled" turns it off.
WEB_SEARCH_PROVIDER=disabled
TAVILY_API_KEY=
WEB_SEARCH_TIMEOUT_SECONDS=12
